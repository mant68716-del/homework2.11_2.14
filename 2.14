import numpy as np
import skfuzzy as fuzzy
from skfuzzy import control as ctrl
#dau vao Antecedent
mat_do = ctrl.Antecedent(np.arange(0, 11, 1), 'mat_do')
khan_cap = ctrl.Antecedent(np.arange(0, 11, 1), 'khan_cap')
tai_trong = ctrl.Antecedent(np.arange(0, 11, 1), 'tai_trong')
giao_thong = ctrl.Antecedent(np.arange(0, 11, 1), 'giao_thong')
loi_nhuan = ctrl.Antecedent(np.arange(0, 11, 1), 'loi_nhuan')

# Đầu ra consequent
ket_hop = ctrl.Consequent(np.arange(0, 11, 1), 'ket_hop')
uu_tien = ctrl.Consequent(np.arange(0, 11, 1), 'uu_tien')


cac_bien = [mat_do, khan_cap, tai_trong, giao_thong, loi_nhuan, ket_hop, uu_tien]
for bien in cac_bien:
    bien['thap']=fuzzy.trimf(bien.universe,[0,0,5])
    bien['trungbinh']=fuzzy.trimf(bien.universe,[0,5,10])
    bien['cao']=fuzzy.trimf(bien.universe,[5,10,10])

rules = [
    #rules ket hop
    ctrl.Rule(mat_do['cao'] & tai_trong['thap'] & giao_thong['thap'], ket_hop['cao']),
    ctrl.Rule(mat_do['trungbinh'] & giao_thong['cao'] & khan_cap['trungbinh'], ket_hop['trungbinh']),
    ctrl.Rule(tai_trong['cao'] & mat_do['cao'] & loi_nhuan['trungbinh'], ket_hop['trungbinh']),
    ctrl.Rule(mat_do['thap'] & khan_cap['cao'] & giao_thong['trungbinh'], ket_hop['trungbinh']),
    ctrl.Rule(loi_nhuan['cao'] & khan_cap['cao'] & giao_thong['cao'], ket_hop['trungbinh']),
    ctrl.Rule(mat_do['cao'] & giao_thong['trungbinh'] & khan_cap['trungbinh'], ket_hop['trungbinh']),

#rules uatien
    ctrl.Rule(khan_cap['cao'] & loi_nhuan['cao'], uu_tien['cao']),
    ctrl.Rule(khan_cap['trungbinh'] & giao_thong['trungbinh'], uu_tien['trungbinh']),
    ctrl.Rule(khan_cap['thap'] & mat_do['cao'] & loi_nhuan['thap'], uu_tien['thap']),
    ctrl.Rule(giao_thong['trungbinh'] & loi_nhuan['trungbinh'] & tai_trong['thap'], uu_tien['trungbinh'])


]

rules_ctrl = ctrl.ControlSystem(rules)
mo_phong = ctrl.ControlSystemSimulation(rules_ctrl)


mo_phong.input['mat_do'] = 9 
mo_phong.input['khan_cap'] = 5
mo_phong.input['tai_trong'] = 2
mo_phong.input['giao_thong'] = 5
mo_phong.input['loi_nhuan'] = 5
 
mo_phong.compute()
 
diem_ket_hop = mo_phong.output['ket_hop']
diem_uu_tien = mo_phong.output['uu_tien']

print(f"Chỉ số kết hợp đơn hàng: {diem_ket_hop:.2f} / 10")
print(f"Chỉ số ưu tiên giao hàng: {diem_uu_tien:.2f} / 10")

mat_do.view(sim=mo_phong)
khan_cap.view(sim=mo_phong)
tai_trong.view(sim=mo_phong)
giao_thong.view(sim=mo_phong)
loi_nhuan.view(sim=mo_phong)
